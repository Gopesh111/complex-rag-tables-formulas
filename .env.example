# Core LLM Provider (Required for LlamaIndex Element Node Parsing)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Vector Database Path (Optional: defaults to ./chroma_db)
CHROMA_DB_PATH=./chroma_db

