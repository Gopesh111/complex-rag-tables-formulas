#Code (Imports & Setup)
import os
import pdfplumber
from docling.document_converter import DocumentConverter

# Define test file path (Make sure you have a messy PDF here)
TEST_FILE = "../data/sample_complex.pdf"

print(f"Testing on: {TEST_FILE}")
print(f"File exists: {os.path.exists(TEST_FILE)}")

#Code (pdfplumber logic)
def test_pdfplumber(filepath):
    print("--- Running pdfplumber extraction ---")
    extracted_tables = []
    try:
        with pdfplumber.open(filepath) as pdf:
            # Testing on the first two pages to save time
            for i, page in enumerate(pdf.pages[:2]):
                tables = page.extract_tables()
                for table in tables:
                    extracted_tables.append(table)
                    
        print(f"Found {len(extracted_tables)} tables.")
        if extracted_tables:
            print("\nPreview of first table's first row:")
            print(extracted_tables[0][0]) # Preview headers
            
    except Exception as e:
        print(f"Error: {e}")

test_pdfplumber(TEST_FILE)

#Code (Docling logic)
def test_docling(filepath):
    print("--- Running Docling extraction ---")
    converter = DocumentConverter()
    
    try:
        result = converter.convert(filepath)
        markdown_output = result.document.export_to_markdown()
        
        print("Conversion Successful!")
        print(f"Total Characters Extracted: {len(markdown_output)}")
        
        # Print a snippet to verify markdown tables and LaTeX
        print("\n--- Markdown Snippet Preview ---")
        # Just printing a middle chunk where a table might exist
        print(markdown_output[1000:1500]) 
        
    except Exception as e:
        print(f"Docling Error: {e}")

test_docling(TEST_FILE)

